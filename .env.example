# OmniDoxa environment template
# Copy this file to .env.local for local development and fill in real values there.
# Do not commit .env.local or any real secrets.

# Phase 1: app metadata / deployment shell
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Phase 1.6: Turso / libSQL database
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# Phase 3: temporary admin access gate until Clerk/Admin grants are wired
OMNIDOXA_ADMIN_TOKEN=replace_with_a_long_random_admin_token

# Phase 4: xAI / Grok analysis provider
XAI_API_KEY=your_xai_api_key
XAI_MODEL=grok-4

# Phase 6: Clerk identity
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_secret

# Phase 6: Stripe subscriptions
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Phase 6+: email
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL="OmniDoxa <briefings@example.com>"

# Phase 6+: briefing data providers
WEATHER_API_KEY=your_weather_api_key
MARKET_DATA_API_KEY=your_market_data_api_key
NEWSDATA_API_KEY=your_newsdata_api_key

# Phase 8: automation / protected scheduled routes
CRON_SECRET=replace_with_a_long_random_value
